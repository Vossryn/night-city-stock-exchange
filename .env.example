# Application Title
VITE_APP_TITLE=Night City Stock Exchange

# Game Configuration
VITE_INITIAL_CASH=10000
VITE_MARKET_TICK_RATE=5000

# Feature Flags
VITE_ENABLE_DEBUG_TOOLS=false

# Better Auth Secret (REQUIRED - generate a random string)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-this-to-a-random-secret-in-production

# Google Authentication
VITE_GOOGLE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_SECRET=placeholder-client-secret

# Github Authentication
VITE_GITHUB_CLIENT_ID=placeholder-github-client-id
VITE_GITHUB_CLIENT_SECRET=placeholder-github-client-secret
